# ---- Public (exposed to the browser) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only (NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
# Must be a domain verified in Resend (onboarding@resend.dev works for testing to your own address)
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Any long random string: used to hash IPs for rate limiting
RATE_LIMIT_SALT=replace-with-a-long-random-string
